## 运行端口
VITE_PORT = 2001

## 网站根目录
VITE_PUBLIC_PATH = "/"

## 打包路径（静态资源）（可以改为具体的 cdn 加速地址）
STATIC_ASSET_BASE_URL = "/"

## 打包输出路径
BUILD_OUT_DIR = "dist"

## 接口基础地址
VITE_API_BASE_URL = "/api"

## 本地缓存加密
VITE_STORAGE_CRYPTO = "true"

## 启用移动端访问
VITE_ENABLE_MOBILE = "true"

## 应用版本号
VITE_APP_VERSION = "1.0.0.260101"
